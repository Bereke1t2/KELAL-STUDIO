<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- gal (features/export): only relevant on API <= 29 (this app's
         minSdk is 24, see mobile/CLAUDE.md's decisions log) — API 30+
         devices save to the gallery via MediaStore without this
         permission. Not declared by gal's own plugin manifest (verified:
         it's empty), so the app must declare it itself. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <!-- flutter_local_notifications (features/reminders): Android 13+
         (API 33) requires this runtime permission to display any
         notification at all — permission_handler's Permission.notification
         request (see LocalNotificationScheduler.requestPermission) is a
         no-op without this manifest declaration present. Deliberately NOT
         declaring SCHEDULE_EXACT_ALARM/USE_EXACT_ALARM: reminders are
         scheduled with AndroidScheduleMode.inexactAllowWhileIdle (a
         "post around this time" reminder has no need for to-the-second
         exact-alarm precision, which on API 31+ also needs a separate,
         more invasive user-granted permission this feature's access
         footprint doesn't justify). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <application
        android:label="kelal_studio"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:requestLegacyExternalStorage="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin.

         share_plus (features/export) needs no entry added here: its Android
         implementation invokes ACTION_SEND/ACTION_SEND_MULTIPLE through the
         system chooser (Intent.createChooser), which is exempt from
         Android 11+ package-visibility <queries> requirements, and its own
         plugin manifest (verified: declares only a FileProvider + a
         PendingIntent broadcast receiver, no <queries> block) is merged in
         automatically by Gradle — nothing to add or duplicate here. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
