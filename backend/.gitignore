# Compiled binaries
/bin/
*.exe
*.test

# Local secrets / env — NEVER commit real provider keys or JWT secrets (PRD §7.8)
.env
.env.*
!.env.example

# Test / coverage artifacts
coverage.out
coverage.html

# Locally-stored uploaded assets (dev only; PRD §6.8 stores outside web root)
/storage/

# Go workspace files
go.work
go.work.sum

# OS / editor cruft
.DS_Store
*.swp

# Claude Code review-passed marker (regenerated per commit, not source)
.claude/.review-passed
