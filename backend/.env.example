# Kelal Studio backend — configuration.
#
# Copy to `.env` for local dev (`cp .env.example .env`). The .env file is
# gitignored. NEVER put a real provider API key or JWT secret in a committed
# file — provider keys are server-side only and must never reach the mobile
# client (PRD §7.8, §10.1).

# ── Server ─────────────────────────────────────────────────────────────────
APP_ENV=development            # development | production
HTTP_PORT=8080
LOG_LEVEL=info                 # debug | info | warn | error

# ── Data source switch ───────────────────────────────────────────────────────
# true  = run entirely on in-memory mock repositories (no Postgres needed) —
#         the backend analogue of the mobile app's Env.useMockApi.
# false = use the real GORM/Postgres repositories.
USE_MOCK_DATA=false

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
# DATABASE_URL takes precedence if set; otherwise the DSN is assembled from the
# parts below. Ignored entirely when USE_MOCK_DATA=true.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_USER=kelal
DB_PASSWORD=kelal
DB_NAME=kelal_studio
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=1h

# ── Auth / JWT (PRD §6.1) ────────────────────────────────────────────────────
# REQUIRED in production; the server refuses to boot with the dev defaults when
# APP_ENV=production. Use long random secrets.
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h           # 30 days

# ── Rate limiting (PRD §1.1 gateway, §12) ────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60       # per authenticated user
RATE_LIMIT_IP_PER_MINUTE=120   # per client IP (pre-auth)

# ── Quota / abuse control (PRD §6.14, §12) ───────────────────────────────────
QUOTA_TEXT_DAILY=50
QUOTA_IMAGE_DAILY=20
GLOBAL_DAILY_SPEND_CEILING_USD=0   # 0 = disabled; >0 enables the auto-shutoff

# ── Provider Abstraction Layer (PRD §10.1) ───────────────────────────────────
# OQ-20: no primary AI model has been chosen yet, so the app ships with STUB
# providers. Real provider keys live here (SERVER-SIDE ONLY). Leave the order at
# `stub` to keep using the deterministic fakes.
TEXT_PROVIDER_ORDER=stub       # comma-separated failover order, e.g. nemotron,gemini
IMAGE_PROVIDER_ORDER=stub      # e.g. flux,pollinations
PROVIDER_TIMEOUT=20s           # per-provider call timeout
# OQ-13 / OQ-19: prompt confidentiality + data residency are OPEN. Provider
# request/response logging is therefore OFF by default; do not flip on before
# those questions are answered.
PROVIDER_LOG_REQUESTS=false
# NEMOTRON_API_KEY=
# GEMINI_API_KEY=
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=

# ── Async video queue (PRD §10.3) ────────────────────────────────────────────
# Queue technology is unspecified in the PRD; the default is an in-process
# queue. A real broker is a flagged TODO.
QUEUE_DRIVER=inproc            # inproc
VIDEO_JOB_MAX_ATTEMPTS=3

# ── Uploads / assets (PRD §6.8) ──────────────────────────────────────────────
ASSET_STORAGE_DIR=./storage/assets   # stored OUTSIDE any web root
ASSET_MAX_BYTES=10485760             # 10 MiB
ASSET_MAX_DIMENSION=4096
ASSET_MIN_DIMENSION=200
